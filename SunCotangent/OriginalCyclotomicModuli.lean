import SunCotangent.LiteralSectionFourBounds

/-!
# The three original Section 4 cyclotomic moduli

This file records the three 61-bit moduli used by the coefficientwise
certificate in Section 4 of the paper.  It also connects that literal
coefficient statement to the integral certificate proved elsewhere in the
formalization.

The original C++ subset-DP computation is not replayed here.  Instead, the
stronger integral equality `canonicalConstant = certificateInteger` implies
all twenty-eight of its modular coefficient checks.  The passage from the
centered certificate to the paper's literal cyclic representative is proved
through the ideal generated by `1 + X + ... + X^28`; the desired canonical
coefficient identity is not assumed.
-/

open scoped BigOperators

namespace SunCotangent
namespace OriginalCyclotomicModuli

open CyclotomicCertificate LiteralSectionFourBounds

noncomputable section

/-! ## The three moduli and the lifting interval -/

/-- The first 61-bit modulus in the Section 4 computation. -/
def paperModulus1 : ℕ := 2_305_843_009_213_693_951

/-- The second 61-bit modulus in the Section 4 computation. -/
def paperModulus2 : ℕ := 2_305_843_009_213_693_921

/-- The third 61-bit modulus in the Section 4 computation. -/
def paperModulus3 : ℕ := 2_305_843_009_213_693_907

theorem paperModuli_isCoprime12 :
    IsCoprime (paperModulus1 : ℤ) (paperModulus2 : ℤ) := by
  decide +kernel

theorem paperModuli_isCoprime13 :
    IsCoprime (paperModulus1 : ℤ) (paperModulus3 : ℤ) := by
  decide +kernel

theorem paperModuli_isCoprime23 :
    IsCoprime (paperModulus2 : ℤ) (paperModulus3 : ℤ) := by
  decide +kernel

/-- The product `Q` of the three original pairwise-coprime moduli. -/
def paperModulusProduct : ℤ :=
  (paperModulus1 : ℤ) * paperModulus2 * paperModulus3

/-- The exact decimal value printed for `Q` in Section 4. -/
theorem paperModulusProduct_eq :
    paperModulusProduct =
      12_259_964_326_927_110_457_464_553_515_448_388_006_472_404_964_466_489_997 := by
  norm_num [paperModulusProduct, paperModulus1, paperModulus2,
    paperModulus3]

/-- The coefficient bound `B = 14! * 29^29` from Section 4. -/
def paperBoundB : ℤ := (Nat.factorial 14 : ℤ) * 29 ^ 29

/-- The absolute value `E` of the claimed constant coefficient. -/
def paperBoundE : ℤ := 84_643_985_981_440 * 29 ^ 14

theorem paperBoundB_eq_sectionFourLiftingBound :
    paperBoundB = sectionFourLiftingBound := by
  rfl

theorem paperBoundE_eq_neg_certificateInteger :
    paperBoundE = -certificateInteger := by
  norm_num [paperBoundE, certificateInteger]

/-- The exact strict inequality that makes simultaneous CRT lifting unique. -/
theorem paperModulusProduct_gt_twice_bound :
    paperModulusProduct > 2 * (paperBoundB + paperBoundE) := by
  norm_num [paperModulusProduct, paperModulus1, paperModulus2,
    paperModulus3, paperBoundB, paperBoundE, Nat.factorial]

/-! ## Canonical coefficients are invariant modulo the cyclotomic sum -/

private theorem cyclotomicSum_coeff_eq_one (e : Z29) :
    cyclotomicSum.coeff e = 1 := by
  simp [cyclotomicSum, monomial]

/-- Multiplying the full cyclic sum by any group-ring element produces a
cyclic vector with the same coefficient at every exponent. -/
private theorem mul_cyclotomicSum_coeff_eq
    (a : Cyclic ℤ) (x y : Z29) :
    (a * cyclotomicSum).coeff x =
      (a * cyclotomicSum).coeff y := by
  classical
  rw [AddMonoidAlgebra.coeff_mul_apply_left,
    AddMonoidAlgebra.coeff_mul_apply_left]
  simp only [cyclotomicSum_coeff_eq_one, mul_one]

private theorem quotientMap_permanent_literalCyclotomicMatrix :
    cyclotomicQuotientMap
        (Matrix.permanent literalCyclotomicMatrix) =
      Matrix.permanent literalQuotientMatrix := by
  classical
  simp [literalQuotientMatrix, Matrix.permanent]

/-- Equality of the literal and centered certificates in the cyclotomic
quotient, restated as ideal membership before quotienting. -/
private theorem literal_sub_centered_mem_cyclotomicIdeal :
    literalCertificateCyclic - certificatePolynomial ∈
      Ideal.span ({cyclotomicSum} : Set (Cyclic ℤ)) := by
  refine (Ideal.Quotient.mk_eq_mk_iff_sub_mem
    (I := Ideal.span ({cyclotomicSum} : Set (Cyclic ℤ)))
    literalCertificateCyclic certificatePolynomial).mp ?_
  change cyclotomicQuotientMap literalCertificateCyclic =
    cyclotomicQuotientMap certificatePolynomial
  calc
    cyclotomicQuotientMap literalCertificateCyclic =
        literalQuotientCertificate := by
      rw [literalCertificateCyclic, map_mul,
        quotientMap_permanent_literalCyclotomicMatrix]
      rfl
    _ = cyclotomicQuotientMap certificatePolynomial :=
      literalQuotientCertificate_eq_centered

/-- Subtracting a multiple of the cyclotomic sum does not alter any of the
twenty-eight canonical coefficient differences `c_i - c_28`. -/
private theorem canonicalCoeff_eq_of_sub_mem_cyclotomicIdeal
    {f g : Cyclic ℤ}
    (h : f - g ∈ Ideal.span ({cyclotomicSum} : Set (Cyclic ℤ)))
    (i : Fin 28) :
    canonicalCoeff f i = canonicalCoeff g i := by
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp h
  have hcoeff := mul_cyclotomicSum_coeff_eq a
    ((i.val : ℕ) : Z29) (28 : Z29)
  rw [ha] at hcoeff
  unfold canonicalCoeff
  simp only [AddMonoidAlgebra.coeff_sub, Finsupp.sub_apply] at hcoeff
  linear_combination hcoeff

private theorem canonicalIndex_ne_zero :
    ∀ i : Fin 28, i ≠ 0 → ((i.val : ℕ) : Z29) ≠ 0 := by
  decide +kernel

/-- The centered normal form has one possibly nonzero canonical coefficient,
at index zero. -/
private theorem canonicalCoeff_certificatePolynomial (i : Fin 28) :
    canonicalCoeff certificatePolynomial i =
      if i = 0 then canonicalConstant else 0 := by
  by_cases hi : i = 0
  · subst i
    simp [canonicalCoeff, canonicalConstant]
  · have hindex : ((i.val : ℕ) : Z29) ≠ 0 :=
      canonicalIndex_ne_zero i hi
    have h28 : (28 : Z29) ≠ 0 := by decide +kernel
    unfold canonicalCoeff
    rw [certificate_coeff_eq_one _ hindex,
      certificate_coeff_eq_one (28 : Z29) h28]
    simp [hi]

/-- The literal Section 4 certificate has the same canonical normal form as
the centered certificate, before any modular computation is used.  This is
the symbolic bridge that lets an independent computation of
`canonicalConstant` modulo one of the paper's moduli certify all twenty-eight
canonical coefficient differences modulo that modulus. -/
theorem canonicalCoeff_literalCertificateCyclic (i : Fin 28) :
    canonicalCoeff literalCertificateCyclic i =
      if i = 0 then canonicalConstant else 0 := by
  calc
    canonicalCoeff literalCertificateCyclic i =
        canonicalCoeff certificatePolynomial i :=
      canonicalCoeff_eq_of_sub_mem_cyclotomicIdeal
        literal_sub_centered_mem_cyclotomicIdeal i
    _ = if i = 0 then canonicalConstant else 0 :=
      canonicalCoeff_certificatePolynomial i

/-- The literal Section 4 cyclic certificate has exactly the twenty-eight
canonical coefficients asserted in the paper, conditional only on the single
integral equality discharged by the formalized modular computation. -/
theorem canonicalCoeff_literalCertificateCyclic_of_canonicalConstant
    (hcanonical : canonicalConstant = certificateInteger)
    (i : Fin 28) :
    canonicalCoeff literalCertificateCyclic i =
      if i = 0 then certificateInteger else 0 := by
  calc
    canonicalCoeff literalCertificateCyclic i =
        if i = 0 then canonicalConstant else 0 :=
      canonicalCoeff_literalCertificateCyclic i
    _ = if i = 0 then certificateInteger else 0 := by
      rw [hcanonical]

/-! ## The original three modular coefficient certificates -/

/-- The first constant residue printed by the literal 61-bit computation. -/
theorem certificateInteger_mod_paperModulus1 :
    (certificateInteger : ZMod paperModulus1) =
      908_938_787_341_445_998 := by
  apply (ZMod.intCast_eq_intCast_iff_dvd_sub certificateInteger
    908_938_787_341_445_998 paperModulus1).2
  norm_num [certificateInteger, paperModulus1]

/-- The second constant residue printed by the literal 61-bit computation. -/
theorem certificateInteger_mod_paperModulus2 :
    (certificateInteger : ZMod paperModulus2) =
      581_251_497_600_139_858 := by
  apply (ZMod.intCast_eq_intCast_iff_dvd_sub certificateInteger
    581_251_497_600_139_858 paperModulus2).2
  norm_num [certificateInteger, paperModulus2]

/-- The third constant residue printed by the literal 61-bit computation. -/
theorem certificateInteger_mod_paperModulus3 :
    (certificateInteger : ZMod paperModulus3) =
      428_330_762_387_530_326 := by
  apply (ZMod.intCast_eq_intCast_iff_dvd_sub certificateInteger
    428_330_762_387_530_326 paperModulus3).2
  norm_num [certificateInteger, paperModulus3]

theorem literalCanonicalCoeff_mod_paperModulus1
    (hcanonical : canonicalConstant = certificateInteger)
    (i : Fin 28) :
    (canonicalCoeff literalCertificateCyclic i : ZMod paperModulus1) =
      if i = 0 then 908_938_787_341_445_998 else 0 := by
  rw [canonicalCoeff_literalCertificateCyclic_of_canonicalConstant
    hcanonical i]
  by_cases hi : i = 0
  · simpa [hi] using certificateInteger_mod_paperModulus1
  · simp [hi]

theorem literalCanonicalCoeff_mod_paperModulus2
    (hcanonical : canonicalConstant = certificateInteger)
    (i : Fin 28) :
    (canonicalCoeff literalCertificateCyclic i : ZMod paperModulus2) =
      if i = 0 then 581_251_497_600_139_858 else 0 := by
  rw [canonicalCoeff_literalCertificateCyclic_of_canonicalConstant
    hcanonical i]
  by_cases hi : i = 0
  · simpa [hi] using certificateInteger_mod_paperModulus2
  · simp [hi]

theorem literalCanonicalCoeff_mod_paperModulus3
    (hcanonical : canonicalConstant = certificateInteger)
    (i : Fin 28) :
    (canonicalCoeff literalCertificateCyclic i : ZMod paperModulus3) =
      if i = 0 then 428_330_762_387_530_326 else 0 := by
  rw [canonicalCoeff_literalCertificateCyclic_of_canonicalConstant
    hcanonical i]
  by_cases hi : i = 0
  · simpa [hi] using certificateInteger_mod_paperModulus3
  · simp [hi]

/-- A canonical coefficient of the difference between the two sides of
equation (4.1), before reduction modulo any integer. -/
def paperCanonicalDifferenceCoeff (i : Fin 28) : ℤ :=
  canonicalCoeff literalCertificateCyclic i -
    if i = 0 then certificateInteger else 0

theorem paperCanonicalDifferenceCoeff_eq_zero
    (hcanonical : canonicalConstant = certificateInteger)
    (i : Fin 28) :
    paperCanonicalDifferenceCoeff i = 0 := by
  rw [paperCanonicalDifferenceCoeff,
    canonicalCoeff_literalCertificateCyclic_of_canonicalConstant
      hcanonical i]
  simp

theorem paperCanonicalDifferenceCoeff_mod_paperModulus1
    (hcanonical : canonicalConstant = certificateInteger)
    (i : Fin 28) :
    (paperCanonicalDifferenceCoeff i : ZMod paperModulus1) = 0 := by
  rw [paperCanonicalDifferenceCoeff_eq_zero hcanonical i]
  exact Int.cast_zero

theorem paperCanonicalDifferenceCoeff_mod_paperModulus2
    (hcanonical : canonicalConstant = certificateInteger)
    (i : Fin 28) :
    (paperCanonicalDifferenceCoeff i : ZMod paperModulus2) = 0 := by
  rw [paperCanonicalDifferenceCoeff_eq_zero hcanonical i]
  exact Int.cast_zero

theorem paperCanonicalDifferenceCoeff_mod_paperModulus3
    (hcanonical : canonicalConstant = certificateInteger)
    (i : Fin 28) :
    (paperCanonicalDifferenceCoeff i : ZMod paperModulus3) = 0 := by
  rw [paperCanonicalDifferenceCoeff_eq_zero hcanonical i]
  exact Int.cast_zero

/-- The complete original Section 4 modular-certificate data: pairwise
coprimality, the exact product, the lifting inequality, and all twenty-eight
canonical difference coefficients modulo each of the three moduli. -/
theorem paper_cyclotomic_modular_certificate
    (hcanonical : canonicalConstant = certificateInteger) :
    (IsCoprime (paperModulus1 : ℤ) (paperModulus2 : ℤ) ∧
      IsCoprime (paperModulus1 : ℤ) (paperModulus3 : ℤ) ∧
      IsCoprime (paperModulus2 : ℤ) (paperModulus3 : ℤ)) ∧
    paperModulusProduct =
      12_259_964_326_927_110_457_464_553_515_448_388_006_472_404_964_466_489_997 ∧
    paperModulusProduct > 2 * (paperBoundB + paperBoundE) ∧
    ∀ i : Fin 28,
      (paperCanonicalDifferenceCoeff i : ZMod paperModulus1) = 0 ∧
      (paperCanonicalDifferenceCoeff i : ZMod paperModulus2) = 0 ∧
      (paperCanonicalDifferenceCoeff i : ZMod paperModulus3) = 0 := by
  refine ⟨⟨paperModuli_isCoprime12, paperModuli_isCoprime13,
    paperModuli_isCoprime23⟩, paperModulusProduct_eq,
    paperModulusProduct_gt_twice_bound, ?_⟩
  intro i
  exact ⟨paperCanonicalDifferenceCoeff_mod_paperModulus1 hcanonical i,
    paperCanonicalDifferenceCoeff_mod_paperModulus2 hcanonical i,
    paperCanonicalDifferenceCoeff_mod_paperModulus3 hcanonical i⟩

end
end OriginalCyclotomicModuli
end SunCotangent
